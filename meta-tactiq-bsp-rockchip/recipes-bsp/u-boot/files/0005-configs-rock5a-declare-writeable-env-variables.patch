From dd9bcec2fcd0cdc62345818566f28176462ee16d Mon Sep 17 00:00:00 2001
From: Andrey Lazarev <revenue7@gmail.com>
Date: Mon, 7 Sep 2026 20:08:24 +0000
Subject: [PATCH] configs: rock5a-rk3588s: declare writeable environment
 variables

CONFIG_ENV_WRITEABLE_LIST permits writes and imports only for variables
carrying the 'w' flag, and takes that list from the compile-time constant
ENV_FLAGS_LIST_STATIC (env/flags.c), not from the .flags variable in the
environment - deliberately, so that the access list cannot be supplied by
the environment it governs. CFG_ENV_FLAGS_LIST_STATIC defaults to an empty
string, so with the option enabled and no board definition no variable is
writeable and nothing is imported from the saved environment at all.

Declare the three RAUC A/B state variables, as include/configs/hmibsc.h
does upstream for the same scheme. Without them the boot_ab script cannot
decrement the try counter, automatic rollback to the other slot never
happens, and fw_setenv BOOT_ORDER has no effect after a reboot.

bootargs and bootcmd are deliberately left out: keeping them
non-importable is what prevents the kernel command line from being changed
from a running system.

Upstream-Status: Inappropriate [depends on the TactiQ default environment; the variable names come from tactiq-boot.env]
---
 include/configs/rock5a-rk3588s.h | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/include/configs/rock5a-rk3588s.h b/include/configs/rock5a-rk3588s.h
index 9a2d3ee..0be720d 100644
--- a/include/configs/rock5a-rk3588s.h
+++ b/include/configs/rock5a-rk3588s.h
@@ -10,6 +10,30 @@
 		"stdout=serial,vidconsole\0" \
 		"stderr=serial,vidconsole\0"
 
+/*
+ * Writeable environment variables.
+ *
+ * CONFIG_ENV_WRITEABLE_LIST takes this list from a compiled-in constant, not
+ * from the ".flags" variable in the environment: env/flags.c takes
+ * ENV_FLAGS_LIST_STATIC when the option is on, so a ".flags" line in the
+ * default env file has no effect on access control. With no board definition
+ * the list is empty (include/env_flags.h defaults CFG_ENV_FLAGS_LIST_STATIC
+ * to ""), which means no variable carries the writeable flag and nothing is
+ * imported from the saved environment at all.
+ *
+ * These three are the RAUC A/B state. Without them the boot_ab script cannot
+ * decrement the try counter, the automatic rollback to the other slot never
+ * happens, and fw_setenv BOOT_ORDER stops taking effect after a reboot.
+ *
+ * Deliberately only these three: everything else, bootargs and bootcmd
+ * included, stays non-importable, so the kernel command line cannot be
+ * altered from a running system - not by fw_setenv and not by writing the
+ * environment sectors directly.
+ *
+ * Same list and same reasoning as include/configs/hmibsc.h upstream.
+ */
+#define CFG_ENV_FLAGS_LIST_STATIC "BOOT_ORDER:sw,BOOT_A_LEFT:dw,BOOT_B_LEFT:dw"
+
 #include <configs/rk3588_common.h>
 
 #endif /* __ROCK5A_RK3588_H */
-- 

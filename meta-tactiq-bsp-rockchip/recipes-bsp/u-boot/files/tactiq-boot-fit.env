# tactiq-boot-fit.env: U-Boot default environment for TACTIQ_BOOT_METHOD = "fit"
# (CONFIG_USE_DEFAULT_ENV_FILE). The recipe installs it as tactiq-boot.env.
#
# boot_ab loads the signed FIT from the slot's boot partition and runs bootm
# on that slot's configuration. The kernel command line is the /chosen
# bootargs of the configuration's devicetree (tactiq-slot-dtb.bb), inside the
# signature; this environment sets no bootargs variable, so U-Boot leaves
# /chosen as signed. extlinux.conf is not read on this path.
#
# @FIT_CONF_A@ and @FIT_CONF_B@ are replaced at do_configure from
# KERNEL_DEVICETREE, following the naming of tactiq-slot-dtb.bb.
# Format: mkenvimage key=value; lines starting with # are ignored.
# Format verified on hardware (Rock 5A, 2026-07-15).
# Bootcount: U-Boot decrements BOOT_x_LEFT before each attempt; after a
# successful boot rauc-mark-good (meta-rauc, pulled in by rauc) sets it back
# to 3 through the uboot backend. If no slot is left, both counters are reset
# and the board reboots; it never stops at a prompt.
# Rollback floor (CONFIG_FIT_ROLLBACK_TPM): fit_rollback_raise is 1 for a
# slot that enters with BOOT_x_LEFT=3, the value the OS writes when it marks
# the slot good. It is set after env save and is not in the import list, so
# it never comes from the saved environment. U-Boot raises the floor to the
# slot's signed rollback-index only when, in addition, it has booted the same
# image from this slot before (fit_seen_A, fit_seen_B, written by patch 0010).
# A counter of 3 alone is not trusted: a system that predates the floor
# installs a slot with 3. The reset after both slots are spent sets 2, not 3,
# so that a slot which has just failed three times is not taken for a
# confirmed one.
BOOT_ORDER=A B
BOOT_A_LEFT=3
BOOT_B_LEFT=3
scriptaddr=0x00c00000
fdt_addr_r=0x12000000
kernel_addr_r=0x02000000
ramdisk_addr_r=0x12180000
pxefile_addr_r=0x00e00000
boot_ab=for slot in ${BOOT_ORDER}; do if test "${slot}" = "A"; then if test ${BOOT_A_LEFT} -gt 0; then if test ${BOOT_A_LEFT} -eq 3; then setenv raise_next 1; else setenv raise_next 0; fi; setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1; env save; setenv fit_rollback_raise ${raise_next}; setenv rauc_slot A; setenv rauc_part rootfs_a; echo "TactiQ: booting slot A (BOOT_A_LEFT now ${BOOT_A_LEFT}, raise ${fit_rollback_raise})"; load mmc 0:1 ${kernel_addr_r} /fitImage && bootm ${kernel_addr_r}#@FIT_CONF_A@; fi; fi; if test "${slot}" = "B"; then if test ${BOOT_B_LEFT} -gt 0; then if test ${BOOT_B_LEFT} -eq 3; then setenv raise_next 1; else setenv raise_next 0; fi; setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1; env save; setenv fit_rollback_raise ${raise_next}; setenv rauc_slot B; setenv rauc_part rootfs_b; echo "TactiQ: booting slot B (BOOT_B_LEFT now ${BOOT_B_LEFT}, raise ${fit_rollback_raise})"; load mmc 0:3 ${kernel_addr_r} /fitImage && bootm ${kernel_addr_r}#@FIT_CONF_B@; fi; fi; done; echo "TactiQ: no bootable slot - resetting counters and rebooting"; setenv BOOT_A_LEFT 2; setenv BOOT_B_LEFT 2; env save; reset
bootcmd=run boot_ab
# NOTE: this line does NOT grant write access. CONFIG_ENV_WRITEABLE_LIST makes
# env/flags.c read ENV_FLAGS_LIST_STATIC, a compile-time constant, so that the
# access list cannot come from the environment it governs. The list actually in
# force is CONFIG_ENV_FLAGS_LIST_STATIC: the A/B variables from the board
# defconfig (patch 0003), with fit_seen_A and fit_seen_B added by
# fit-rollback.cfg. Keep this line in step with fit-rollback.cfg.
.flags=BOOT_ORDER:sw,BOOT_A_LEFT:dw,BOOT_B_LEFT:dw,fit_seen_A:sw,fit_seen_B:sw

# tactiq-boot.env — U-Boot default environment (CONFIG_USE_DEFAULT_ENV_FILE)
# Format: mkenvimage key=value; lines starting with # are ignored.
# Format verified on hardware (Rock 5A, 2026-07-15).
# NOTE: U-Boot half of bootcount only. The userspace reset of LEFT=3 is not
# implemented, so a slot that boots successfully does not clear the counter.
BOOT_ORDER=A B
BOOT_A_LEFT=3
BOOT_B_LEFT=3
scriptaddr=0x00c00000
fdt_addr_r=0x12000000
kernel_addr_r=0x02000000
ramdisk_addr_r=0x12180000
pxefile_addr_r=0x00e00000
boot_ab=for slot in ${BOOT_ORDER}; do if test "${slot}" = "A"; then if test ${BOOT_A_LEFT} -gt 0; then setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1; env save; setenv rauc_slot A; setenv rauc_part rootfs_a; echo "TactiQ: booting slot A (BOOT_A_LEFT now ${BOOT_A_LEFT})"; sysboot mmc 1:1 any ${scriptaddr} /boot/extlinux/extlinux.conf; fi; fi; if test "${slot}" = "B"; then if test ${BOOT_B_LEFT} -gt 0; then setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1; env save; setenv rauc_slot B; setenv rauc_part rootfs_b; echo "TactiQ: booting slot B (BOOT_B_LEFT now ${BOOT_B_LEFT})"; sysboot mmc 1:3 any ${scriptaddr} /boot/extlinux/extlinux.conf; fi; fi; done; echo "TactiQ: no bootable slot - dropping to prompt"
bootcmd=run boot_ab
.flags=BOOT_ORDER:sw,BOOT_A_LEFT:dw,BOOT_B_LEFT:dw

pylibfdt: use SWIG_AppendOutput for SWIG >= 4.3 compatibility

SWIG 4.3 changed SWIG_Python_AppendOutput() to take a third is_void
argument; the explicit 2-arg calls in the libfdt.i typemaps no longer
compile. Switch to the version-agnostic SWIG_AppendOutput macro, the
same approach as the upstream dtc fix. Needed since Yocto wrynose
ships swig-native 4.3.

Upstream-Status: Backport

--- a/scripts/dtc/pylibfdt/libfdt.i_shipped	2026-06-05 08:34:58.074357541 +0300
+++ b/scripts/dtc/pylibfdt/libfdt.i_shipped	2026-06-05 08:34:58.082357556 +0300
@@ -1037,7 +1037,7 @@
 			fdt_string(fdt1, fdt32_to_cpu($1->nameoff)));
 		buff = PyByteArray_FromStringAndSize(
 			(const char *)($1 + 1), fdt32_to_cpu($1->len));
-		resultobj = SWIG_Python_AppendOutput(resultobj, buff);
+		resultobj = SWIG_AppendOutput(resultobj, buff);
 	}
 }
 
@@ -1076,7 +1076,7 @@
 
 %typemap(argout) int *depth {
         PyObject *val = Py_BuildValue("i", *arg$argnum);
-        resultobj = SWIG_Python_AppendOutput(resultobj, val);
+        resultobj = SWIG_AppendOutput(resultobj, val);
 }
 
 %apply int *depth { int *depth };
@@ -1092,7 +1092,7 @@
            if (PyTuple_GET_SIZE(resultobj) == 0)
               resultobj = val;
            else
-              resultobj = SWIG_Python_AppendOutput(resultobj, val);
+              resultobj = SWIG_AppendOutput(resultobj, val);
         }
 }
 

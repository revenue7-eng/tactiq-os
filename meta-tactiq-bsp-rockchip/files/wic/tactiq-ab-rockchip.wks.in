# TactiQ OS A/B Partition Layout — Rockchip BSP
# Target: RK3588 family — Rock 5A (RK3588S), Rock 5T (RK3588), other RK3588(S) boards
# Storage: microSD / eMMC / NVMe (loader area written to raw sectors before GPT)
#
# Layout:
#   [Rockchip loader area - no partition table]
#     idbloader.img @ 64 sectors
#     u-boot.itb    @ 16384 sectors
#   [GPT partition table]
#     Part 1: boot_a   (256MB, ext4) - kernel + dtb + initramfs
#     Part 2: rootfs_a  (2GB, ext4)  - active root filesystem
#     Part 3: boot_b   (256MB, ext4) - standby kernel
#     Part 4: rootfs_b  (2GB, ext4)  - standby root filesystem
#     Part 5: data      (4GB, ext4)  - persistent data (counters, keys, config, audit)

# Rockchip loader blobs (written directly, no partition)
part --source rawcopy --sourceparams="file=idbloader.img" --no-table --offset ${RK3588_IDBLOADER_OFFSET_KIB}k
part --source rawcopy --sourceparams="file=u-boot.itb" --no-table --offset ${RK3588_UBOOT_OFFSET_KIB}k

# Partition A (active)
part --source rawcopy --sourceparams="file=${IMGDEPLOYDIR}/${IMAGE_LINK_NAME}.bootext4" --fstype=ext4 --label boot_a --align 4096 --size 256M --active
part / --source rawcopy --sourceparams="file=${IMGDEPLOYDIR}/${IMAGE_LINK_NAME}.ext4.verity" --fstype=none --label rootfs_a --align 4096 --size 2048M --no-fstab-update

# Partition B (standby - same content as A after the initial flash, so that
# either slot can boot before the first bundle install)
part --source rawcopy --sourceparams="file=${IMGDEPLOYDIR}/${IMAGE_LINK_NAME}.bootext4" --fstype=ext4 --label boot_b --align 4096 --size 256M
part --source rawcopy --sourceparams="file=${IMGDEPLOYDIR}/${IMAGE_LINK_NAME}.ext4.verity" --fstype=none --label rootfs_b --align 4096 --size 2048M --no-fstab-update

# Persistent data partition (survives A/B updates)
part /data --fstype=ext4 --label data --align 4096 --size 4096M

bootloader --ptable gpt

root@tactiq-rock5a:~# CL=$(cat /proc/cmdline); se=$(getenforce 2>/dev/null || echo NO-SELINUX); P=/sys/kernel/security/ima/policy; if [ -r $P ]; then ima="appraise-rules=$(grep -c '^appraise ' $P) measure-rules=$(grep -c '^measure ' $P)"; else ima=NO-POLICY-READ; fi; ip=$(echo "$CL" | sed -n 's/.*ima_appraise=\([^ ]*\).*/\1/p'); [ -z "$ip" ] && ip=none; rt=$(echo "$CL" | sed -n 's/.*\(root=[^ ]*\).*/\1/p'); dm=$(cat /sys/block/dm-*/dm/name 2>/dev/null | tr '\n' ' '); [ -z "$dm" ] && dm=NONE; sl=$(echo "$CL" | sed -n 's/.*rauc\.slot=\([^ ]*\).*/\1/p'); printf 'SELINUX %s\nIMA     %s cmdline=%s\nROOT    %s\nDM      %s\nSLOT    %s\n' "$se" "$ima" "$ip" "$rt" "$dm" "$sl"
SELINUX Enforcing
IMA     appraise-rules=4 measure-rules=8 cmdline=none
ROOT    root=/dev/dm-0
DM      rootfs
SLOT    B

-rwxr-xr-x    1 root     root            35 Nov  4  2026 release
-rwxr-xr-x    1 root     root            72 Nov  4  2026 release.sig
root@tactiq-rock5a:~# /opt/tactiq/bin/tactiq-stop status $(cat /run/usb/stopiv/n1.txt) > /run/usb/stopiv/r1.tqsr
status receipt: stop counter 8145, Stopped, 646 bytes, bound to the given nonce
root@tactiq-rock5a:~#

## piece 2
root@tactiq-rock5a:~# /opt/tactiq/bin/tactiq-stop status $(cat /run/usb/stopiv/n2.txt) > /run/usb/stopiv/r2.tqsr
status receipt: stop counter 8145, Stopped, 648 bytes, bound to the given nonce
root@tactiq-rock5a:~# mkdir -p /data/tactiq/stop; cp /run/usb/stopiv/release /run/usb/stopiv/release.sig /data/tactiq/stop/
root@tactiq-rock5a:~# /opt/tactiq/bin/tactiq-stop recover
stop counter 8145 -> 8146: Running
service confirms: calls pass
root@tactiq-rock5a:~# /opt/tactiq/bin/tactiq-stop trip
stop counter 8146 -> 8147: Stopped
service confirms: calls are refused
root@tactiq-rock5a:~# /opt/tactiq/bin/tactiq-stop status $(cat /run/usb/stopiv/n3.txt) > /run/usb/stopiv/r3.tqsr
status receipt: stop counter 8147, Stopped, 647 bytes, bound to the given nonce
root@tactiq-rock5a:~# sync
root@tactiq-rock5a:~#


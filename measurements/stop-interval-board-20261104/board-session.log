# Console of the board over UART (PuTTY, Copy All), three pieces of one run.
# Piece 1: after boot, r1. Piece 2: r2, recover, trip, r3. Piece 3: after the cold start, r4.
# Pasted as copied; nothing removed inside a piece.

## piece 1
tactiq-rock5a login: root

  ▀▀▀▀▀▀▀▀▀▀▀▄   release  TactiQ OS v2.1.0-rc14 (tactiq-image-dev)
     █  █    █   board    Radxa ROCK 5A
     █  █    █   slot     A
     █  █   ▄█   root     dm-verity, dm-0 "rootfs" (as booted)
     ▀   ▀▀▀▀▄   selinux  enforcing
                 ima      policy: measure 8, appraise 4, 164 entries measured
                 tpm      present, TPM 2.0, IFX, firmware 7.87.19691.2
                 pcr 0-9  sha256 500aba3e6917...4336866a0bec
                 agent    active, envelopes: 2880 complete

  Reported by this device. Check it from outside with VERIFY-L3 for v2.1.0-rc14
  and the signed release set; this screen is not a verification.

root@tactiq-rock5a:~# mkdir -p /run/usb; mount -t vfat /dev/sda1 /run/usb; ls -l /run/usb/stopiv
-rwxr-xr-x    1 root     root            65 Nov  4  2026 n1.txt
-rwxr-xr-x    1 root     root            65 Nov  4  2026 n2.txt
-rwxr-xr-x    1 root     root            65 Nov  4  2026 n3.txt

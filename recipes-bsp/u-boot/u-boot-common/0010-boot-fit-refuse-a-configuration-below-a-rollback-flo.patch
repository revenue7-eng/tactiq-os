index 26e9323d..9035e81c 100644
--- a/boot/image-fit.c
+++ b/boot/image-fit.c
@@ -2211,6 +2211,16 @@ int fit_image_load(struct bootm_headers *images, ulong addr,
 			puts("OK\n");
 		}
 
+#if !defined(USE_HOSTCC) && IS_ENABLED(CONFIG_FIT_ROLLBACK_TPM)
+		/* Once per bootm: the kernel is the first image loaded. */
+		if (image_type == IH_TYPE_KERNEL &&
+		    fit_rollback_check(fit, cfg_noffset,
+				       FIT_IMAGE_ENABLE_VERIFY && images->verify)) {
+			bootstage_error(bootstage_id + BOOTSTAGE_SUB_HASH);
+			return -EACCES;
+		}
+#endif
+
 		bootstage_mark(BOOTSTAGE_ID_FIT_CONFIG);
 
 		noffset = fit_conf_get_prop_node(fit, cfg_noffset, prop_name,
diff --git a/include/image.h b/include/image.h
index 1de0a840..7c190022 100644
--- a/include/image.h
+++ b/include/image.h
@@ -1461,6 +1461,23 @@ int fit_image_verify_with_data(const void *fit, int image_noffset,
 int fit_image_verify(const void *fit, int noffset);
 #if CONFIG_IS_ENABLED(FIT_SIGNATURE)
 int fit_config_verify(const void *fit, int conf_noffset);
+
+/**
+ * fit_rollback_check() - Hold a FIT configuration against the rollback floor
+ *
+ * Reads the "rollback-index" property of the configuration (0 when absent)
+ * and compares it with the floor kept in the TPM (FIT_ROLLBACK_TPM). When
+ * @verified is true, the environment variable "fit_rollback_raise" is "1"
+ * and the slot named by "rauc_slot" booted this configuration before
+ * (recorded in "fit_seen_<slot>"), raises the floor to the index first.
+ * Records the configuration in "fit_seen_<slot>" when it was not.
+ *
+ * @fit:	FIT blob
+ * @conf_noffset: Offset of the configuration node
+ * @verified:	The configuration signature has been verified
+ * Return: 0 if the configuration may boot, -ve on refusal or TPM failure
+ */
+int fit_rollback_check(const void *fit, int conf_noffset, bool verified);
 int fit_config_verify_with_key_blob(const void *fit, int conf_noffset,
 				    const void *key_blob);
 #else

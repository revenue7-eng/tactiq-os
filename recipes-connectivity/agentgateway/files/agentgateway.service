[Unit]
Description=agentgateway MCP/A2A traffic mediation (in-perimeter)
Documentation=https://github.com/agentgateway/agentgateway
After=network.target tactiq-stop.service
# Every tool call is checked with tactiq-stop first (extAuthz in the config).
# Wants, not Requires: if the stop service is absent or down the gateway still
# runs and denies every call (failureMode: deny), which is the safe direction.
Wants=tactiq-stop.service
# Start limits belong in [Unit]. In [Service] systemd ignores
# StartLimitIntervalSec ("Unknown key", bench 26.10.2026), and the gateway
# was restarted every 10 s without end.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# --file takes a path; --config takes the configuration text itself. With
# --config and a path the gateway tried to parse the path as YAML and never
# started (found on the bench 26.10.2026; the unit had not been run before).
ExecStart=/opt/tactiq/bin/agentgateway --file /etc/tactiq/agentgateway/config.yaml
Restart=on-failure
RestartSec=10

# Resource limits
MemoryMax=256M
CPUQuota=50%

# -------------------------------------------------------------------------
# Privilege model
# SELinux confinement is the primary boundary; the directives below are
# defense-in-depth. This service mediates local traffic only and must
# not be able to initiate external network connections.
# -----------------------------------------------------------------------
User=agentgateway
Group=agentgateway
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# -------------------------------------------------------------------------
# Filesystem isolation
# ------------------------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateMounts=yes
ReadOnlyPaths=/etc/tactiq/agentgateway
ProtectProc=invisible
ProcSubset=pid

# ------------------------------------------------------------------------
# Kernel surface isolation
# ------------------------------------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# ------------------------------------------------------------------------
# Device access -- none (no TPM, no hardware needed)
# ------------------------------------------------------------------------
PrivateDevices=yes

# -----------------------------------------------------------------------
# Process and namespace restrictions
# ----------------------------------------------------------------------
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

# -----------------------------------------------------------------------
# Network restrictions -- local mediation only, no external egress
# Loopback is permitted for the local listener; all other addresses are denied.
# ------------------------------------------------------------------------
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any

# ------------------------------------------------------------------------
# System call filtering
# ------------------------------------------------------------------------
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @swap @raw-io @reboot @cpu-emulation @obsolete @module
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
[Unit]
Description=agentgateway MCP/A2A traffic mediation (in-perimeter)
Documentation=https://github.com/agentgateway/agentgateway
After=network.target

[Service]
Type=simple
ExecStart=/opt/tactiq/bin/agentgateway --config /etc/tactiq/agentgateway/config.yaml
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3

# Resource limits
MemoryMax=256M
CPUQuota=50%

# -------------------------------------------------------------------------
# Privilege model
# SELinux confinement is the primary boundary; the directives below are
# defense-in-depth. This service mediates local traffic only and must
# not be able to initiate external network connections.
# -----------------------------------------------------------------------
User=agentgateway
Group=agentgateway
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# -------------------------------------------------------------------------
# Filesystem isolation
# ------------------------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateMounts=yes
ReadOnlyPaths=/etc/tactiq/agentgateway
ProtectProc=invisible
ProcSubset=pid

# ------------------------------------------------------------------------
# Kernel surface isolation
# ------------------------------------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# ------------------------------------------------------------------------
# Device access -- none (no TPM, no hardware needed)
# ------------------------------------------------------------------------
PrivateDevices=yes

# -----------------------------------------------------------------------
# Process and namespace restrictions
# ----------------------------------------------------------------------
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

# -----------------------------------------------------------------------
# Network restrictions -- local mediation only, no external egress
# Loopback is permitted for the local listener; all other addresses are denied.
# ------------------------------------------------------------------------
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any

# ------------------------------------------------------------------------
# System call filtering
# ------------------------------------------------------------------------
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @swap @raw-io @reboot @cpu-emulation @obsolete @module
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
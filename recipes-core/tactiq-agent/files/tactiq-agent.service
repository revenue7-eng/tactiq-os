[Unit]
ConditionPathExists=!/etc/tactiq/skip-tpm
Description=TactiQ Attestation Agent
Documentation=file:///usr/share/doc/tactiq-os/ATTESTATION.md
After=network-online.target data-tactiq-dirs.service
Wants=network-online.target
RequiresMountsFor=/data

[Service]
Type=simple
ExecStart=/opt/tactiq/bin/tactiq-agent
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3
WatchdogSec=120

# Resource limits
MemoryMax=128M
CPUQuota=25%

# ---------------------------------------------------------------------------
# Privilege model
# ---------------------------------------------------------------------------
# The agent is a TCB-critical service. Run unprivileged where possible;
# what privilege it does need (TPM device access) is granted explicitly
# rather than as part of a generic root context. SELinux confinement to
# tactiq_agent_t is the primary boundary; the directives below are
# defense-in-depth.
User=tactiq-agent
Group=tactiq-agent
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# ---------------------------------------------------------------------------
# Filesystem isolation
# ---------------------------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateMounts=yes
ReadWritePaths=/data/tactiq
ReadOnlyPaths=/etc/tactiq
ProtectProc=invisible
ProcSubset=pid

# ---------------------------------------------------------------------------
# Kernel surface isolation
# ---------------------------------------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# ---------------------------------------------------------------------------
# Device access — TPM only
# ---------------------------------------------------------------------------
PrivateDevices=yes
DeviceAllow=/dev/tpmrm0 rw
DeviceAllow=/dev/tpm0 rw

# ---------------------------------------------------------------------------
# Process and namespace restrictions
# ---------------------------------------------------------------------------
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

# ---------------------------------------------------------------------------
# Network restrictions
# ---------------------------------------------------------------------------
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
# The verifier endpoint is per-deployment configuration; enable specific
# network access via a drop-in (/etc/systemd/system/tactiq-agent.service.d/
# network.conf) on devices where the agent must reach a verifier. By
# default the production posture is offline-first.

# ---------------------------------------------------------------------------
# System call filtering (in-kernel seccomp via systemd)
# ---------------------------------------------------------------------------
# @system-service is systemd's curated set for daemons; explicitly
# remove privileged classes that the agent has no legitimate need for.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @swap @raw-io @reboot @cpu-emulation @obsolete @module
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target

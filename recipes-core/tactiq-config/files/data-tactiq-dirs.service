[Unit]
Description=Prepare TactiQ data partition layout
Requires=data.mount
After=data.mount
Before=tactiq-agent.service

[Service]
Type=oneshot
RemainAfterExit=yes
# TEMPORARY: restorecon relabels /data as dev scaffolding.
# In production the tactiq_vault_data_t label is applied by the
# LUKS unlock unit in the tactiq_vault_t domain (not yet built).
ExecStart=/bin/sh -c '\
    mkdir -p /data/tactiq; \
    restorecon -Rv /data; \
    for d in keys counter audit certs; do mkdir -p /data/tactiq/$d; done; \
    restorecon -Rv /data/tactiq; \
    chmod 0700 /data/tactiq/keys /data/tactiq/counter; \
    chmod 0750 /data/tactiq/audit; \
    chmod 0755 /data/tactiq/certs; \
    chown -R tactiq-agent:tactiq-agent /data/tactiq; \
    sync'
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target

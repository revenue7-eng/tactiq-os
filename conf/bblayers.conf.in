# bblayers.conf: TactiQ OS build input, rock5a target.
#
# This file is a template. The layer-directory placeholder is
# replaced by scripts/init-build.sh with the absolute path to the
# layer set assembled by scripts/setup-layers.sh. Do not edit paths
# by hand.
#
# The list originates in the published buildinfo-rock5a.json for v2.1.0-rc6.
# It is no longer a mirror of it: layers were added after that tag. This
# template, not any buildinfo, is what init-build.sh expands, and
# scripts/check-build-input.sh compares a generated bblayers.conf against it.

POKY_BBLAYERS_CONF_VERSION = "2"
BBPATH = "${TOPDIR}"
BBFILES ?= ""

BBLAYERS ?= " \
  ${LAYERS_DIR}/openembedded-core/meta \
  ${LAYERS_DIR}/meta-openembedded/meta-oe \
  ${LAYERS_DIR}/meta-openembedded/meta-python \
  ${LAYERS_DIR}/meta-openembedded/meta-networking \
  ${LAYERS_DIR}/meta-openembedded/meta-filesystems \
  ${LAYERS_DIR}/meta-selinux \
  ${LAYERS_DIR}/meta-security/meta-integrity \
  ${LAYERS_DIR}/meta-security/meta-tpm \
  ${LAYERS_DIR}/tactiq-os \
  ${LAYERS_DIR}/tactiq-os/meta-tactiq-bsp-rockchip \
  ${LAYERS_DIR}/tactiq-os-selinux \
  ${LAYERS_DIR}/meta-tensorflow-lite \
  ${LAYERS_DIR}/meta-arm/meta-arm-toolchain \
  ${LAYERS_DIR}/meta-arm/meta-arm \
  ${LAYERS_DIR}/meta-rockchip \
  ${LAYERS_DIR}/meta-rauc \
  "
